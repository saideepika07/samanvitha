# =============================================================================
# Samanvitha Client Environment Configuration
# =============================================================================

# Base URL for Samanvitha backend REST API endpoints (MANDATORY, no fallback in production)
VITE_API_URL=https://samanvitha.onrender.com/api

# Feature flag: Enable simulated local browser mock data (true) or use real backend API (false)
VITE_USE_MOCK_DATA=false

# Optional custom map tile provider URL for production (e.g. MapTiler or Stadia Maps with API key)
# If omitted or empty, the application falls back to standard OpenStreetMap tiles
VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=your_maptiler_api_key

