{
  "name": "samanvitha-server",
  "version": "1.0.0",
  "description": "Backend API for Samanvitha - Need-based community donation network",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "seed": "node src/seed/seed.js",
    "seed:sample": "node src/seed/seed.js --with-sample",
    "seed:demo": "node src/seed/seed.js --demo",
    "create-admin": "node src/seed/createAdmin.js",
    "cleanup:data": "node scripts/cleanupTestData.js",
    "check:inconsistent-needs": "node scripts/reconcileInconsistentNeeds.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.2.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 120000
  }
}
