# =============================================================================
# Samanvitha Backend Environment Configuration
# =============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# For local MongoDB: mongodb://127.0.0.1:27017/samanvitha
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/samanvitha?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/samanvitha

# Dedicated Test Database URI (Optional: tests use in-memory mongodb-memory-server by default; safety guards prevent tests from ever modifying Atlas data)
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/samanvitha_test

# JWT Authentication (at least 32 characters; generate a strong random string for production)
JWT_SECRET=your_secure_random_64_character_jwt_secret_here
JWT_EXPIRES_IN=7d

# SMTP Email Configuration (Nodemailer)
# If left blank or unconfigured in development, reset links will be logged to the server console (DEV ONLY)
# For Gmail: Use an App Password (Google Account -> Security -> 2-Step Verification -> App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
MAIL_FROM="Samanvitha Support" <no-reply@samanvitha.org>

# Initial Administrator Provisioning (used only by npm run create-admin / npm run seed)
ADMIN_EMAIL=admin@samanvitha.org
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_NAME="Admin Reviewer"

# File Storage Configuration
# Driver: 'local' (default in development) or 'cloudinary' (MANDATORY in production on Render's ephemeral disk)
# Render's free tier has an ephemeral disk: locally stored files disappear on redeploy or container restart.
# In production, the server will refuse to start if STORAGE_DRIVER=local.
STORAGE_DRIVER=local

# Cloudinary Credentials (required when STORAGE_DRIVER=cloudinary)
# Obtain these from your Cloudinary Console dashboard (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Reservation Expiry Window (in hours, defaults to 72)
RESERVATION_EXPIRY_HOURS=72
